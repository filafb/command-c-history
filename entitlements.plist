<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox: OS enforces no network, no filesystem outside container -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Deliberately omitted: com.apple.security.network.client -->
    <!-- Absence of that key = kernel blocks all outbound connections -->
</dict>
</plist>
